{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "resources/js/**/*",
        "resources/js/**/*.vue",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.ts"
    ],
    "exclude": ["resources/js/**/__tests__/*"],
    "compilerOptions": {
        "verbatimModuleSyntax": false,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "types": ["node"]
    }
}
