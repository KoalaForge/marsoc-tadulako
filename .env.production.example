# ============================================================
# Production environment for the marsoc-tadulako container.
# Copy to /root/marsoc-tadulako/.env ON THE SERVER (never commit real values).
# docker-compose.yml loads it via env_file and overrides a few keys itself
# (APP_ENV, APP_DEBUG, REDIS_HOST, MEDIA_DB_DATABASE).
# ============================================================

APP_NAME="M.R.T — Marine Raider Tadulako"
APP_ENV=production
# php artisan key:generate --show   (run once, paste the result)
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── MongoDB (external, same server/cluster pattern as koalastore) ─────────────
DB_CONNECTION=mongodb
MONGODB_URI="mongodb://USER:PASSWORD@HOST:27017/marsoc_tadulako?authSource=admin&retryWrites=true&w=majority"
MONGODB_DATABASE="marsoc_tadulako"

# ── Redis: the shared container named `redis` on the `backend` network ────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Same password the redis container was started with (REDIS_PASSWORD there).
REDIS_PASSWORD=CHANGE-ME
# The redis container is SHARED with other apps: use a private key prefix and
# separate logical databases so nothing can collide with koalastore / WA bots.
REDIS_PREFIX=marsoc_
CACHE_PREFIX=marsoc_cache_
REDIS_DB=4
REDIS_CACHE_DB=5

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis

# Queue worker (supervisor inside the container) consumes `media,default`.
QUEUE_CONNECTION=redis
MEDIA_QUEUE=media

# ── Files ─────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Fixed by docker-compose.yml (lives on the marsoc-storage volume):
# MEDIA_DB_DATABASE=/app/storage/app/media.sqlite

MAIL_MAILER=log
BROADCAST_CONNECTION=log
